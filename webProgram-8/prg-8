<html>
 <head>
  <title>Program-8</title>
  
  <style>

   img{

   margin-left:400px;
   border-radius:50%;
   width:550px;
   height:550px;
   }
   
   p{
   text-align:center;
   }
   
   </style>
   
 </head>

 <body>
 
   <img src="image1.jpeg" id="image" onmouseover="one()" onmouseout="two()">   <br>       
 
   <p id="pl"><p>
 
 
     <script>
 	
 	 function one(){
 	 
 	 document.getElementById("image").src="image2.jpeg";
 	 document.getElementById("pl").innerHTML="OnmouseHover";
 	 document.getElementById("pl").style.color="blue";
 	 
 	 }
 	
 	function two(){
 	 
 	 document.getElementById("image").src="image3.jpeg";
 	 document.getElementById("pl").innerHTML="OnmouseOut";
 	 document.getElementById("pl").style.color="red";
 	 
 	 }
 	
 	
     </script>
     
 </body>
 
</html>
